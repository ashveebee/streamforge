# ─────────────────────────────────────────────────────────────────────────────
# StreamForge server configuration
#
# Services (Jellyfin, Sonarr, …) are easiest to set up from the Settings page in
# the app, which stores them in a SQLite database under DATA_DIR. The service
# variables below are optional fallbacks: anything saved in Settings overrides
# them, and "Use environment" in Settings reverts to them.
#
# These values stay on the server — the browser never sees service API keys.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP server
PORT=4000
HOST=0.0.0.0
# Set when running behind a reverse proxy (e.g. "1", "loopback", or "true").
TRUST_PROXY=
# "auto" marks the session cookie Secure when the request arrived over HTTPS.
COOKIE_SECURE=auto
SESSION_TTL_HOURS=12
# By default only Jellyfin administrators may sign in.
ALLOW_NON_ADMIN=false

# Where the settings database (streamforge.db) is kept. /data in Docker.
DATA_DIR=./data

# Jellyfin. Users authenticate with their own Jellyfin credentials. If unset
# (and not saved in Settings), the app asks for it on first launch.
JELLYFIN_URL=http://jellyfin:8096
# Optional: the address people open Jellyfin at in their browser, when it
# differs from the one above (e.g. https://jellyfin.example.com). Used for
# links such as "Play in Jellyfin". Every service accepts <NAME>_PUBLIC_URL,
# e.g. SONARR_PUBLIC_URL, and it can also be set in Settings.
JELLYFIN_PUBLIC_URL=
# Optional API key (Dashboard → API Keys). Used for server-wide data and to
# report pending restarts/updates in health checks. Without it, the signed-in
# admin's own token is used.
JELLYFIN_API_KEY=

# Sonarr (Settings → General → API Key)
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Radarr
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# Prowlarr
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# Seerr (Settings → General → API Key)
SEERR_URL=http://seerr:5055
SEERR_API_KEY=

BAZARR_URL=
BAZARR_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=
READARR_URL=
READARR_API_KEY=

# Emergency only: clears two-factor sign-in for this Jellyfin user at start-up.
# STREAMFORGE_RESET_2FA=

# Infinidisk — use the HTTP API, local mount paths, or both.
INFINIDISK_URL=
INFINIDISK_API_KEY=
# Header the API key is sent in.
INFINIDISK_AUTH_HEADER=X-Api-Key
# Endpoint returning drive/volume status as JSON.
INFINIDISK_STATUS_PATH=/api/status
# Optional dedicated liveness endpoint.
INFINIDISK_HEALTH_PATH=
# Comma-separated mount points visible to this server, measured with statfs().
INFINIDISK_MOUNTS=

# Monitoring
HEALTH_INTERVAL_SECONDS=30
DEGRADED_LATENCY_MS=1500
REQUEST_TIMEOUT_MS=8000
# CPU / RAM / network of the machine running StreamForge.
HOST_METRICS=true
HOST_METRICS_INTERVAL_SECONDS=5
