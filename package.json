{
  "name": "streamforge",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "description": "A unified control centre for your Jellyfin media server ecosystem.",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashveebee/streamforge.git"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "demo": "concurrently -n demo,web -c yellow,cyan \"tsx watch scripts/demo-server.ts\" \"STREAMFORGE_API=http://localhost:4010 vite\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist-server/index.js",
    "preview": "npm run build && npm start"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "systeminformation": "^5.33.23",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.78.0",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
